<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="Reserva confirmada"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8">

            <Label Text="{Binding Hospede, StringFormat='Hóspede: {0}'}" />
            <Label Text="{Binding QuartoDescricao, StringFormat='Quarto: {0}'}" />
            <Label Text="{Binding Adultos, StringFormat='Adultos: {0}'}" />
            <Label Text="{Binding Criancas, StringFormat='Crianças: {0}'}" />
            <Label Text="{Binding CheckIn, StringFormat='Check-in: {0:dd/MM/yyyy}'}" />
            <Label Text="{Binding CheckOut, StringFormat='Check-out: {0:dd/MM/yyyy}'}" />
            <Label Text="{Binding Noites, StringFormat='Noites: {0}'}" />
            <Label Text="{Binding ValorTotal, StringFormat='Valor total: {0:C}'}"
                   FontAttributes="Bold" Margin="0,10" />

            <Button Text="Nova reserva" Clicked="OnNovaReservaClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
